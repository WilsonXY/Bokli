#!/bin/bash
# Guard: block dev/agent git activity inside the PROD worktree (~/projects/bokli).
# The prod folder must stay frozen on the deployed tag — see KnowledgeBase/Projects/bokli/Worktree-Layout.md
PROD_DIR="/home/penguin/projects/bokli"
# resolve symlinks & compare
here="$(cd "$PWD" && pwd -P)"
prod="$(cd "$PROD_DIR" 2>/dev/null && pwd -P || echo "$PROD_DIR")"
if [ "$here" = "$prod" ] || [ "$here" = "$prod/" ]; then
  echo "❌ BLOCKED: git $0 in the PROD folder ($PROD_DIR) is forbidden."
  echo "   Prod must stay frozen on the deployed tag (build-stamp boot gate will crash-loop bokli.service otherwise)."
  echo "   Do your work in the DEV worktree: ~/projects/bokli-dev"
  exit 1
fi

# Auto-fix: run `eslint --fix` on the staged JS/TS files and re-stage them; block only on
# what ESLint can't fix. Warnings block too, like CI (`eslint . --max-warnings=0`).
# A file with unstaged changes is only checked, not fixed: re-staging it would commit those hunks.
full=() partial=()
while IFS= read -r -d '' f; do
  if git diff --quiet -- "$f"; then full+=("$f"); else partial+=("$f"); fi
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.js' '*.jsx' '*.mjs' '*.cjs' '*.ts' '*.tsx' '*.mts' '*.cts')
[ ${#full[@]} -eq 0 ] && [ ${#partial[@]} -eq 0 ] && exit 0

eslint=node_modules/.bin/eslint
if [ ! -x "$eslint" ]; then
  echo "❌ pre-commit: $eslint not found; run npm ci (or commit with --no-verify)."
  exit 1
fi

status=0
if [ ${#full[@]} -gt 0 ]; then
  "$eslint" --fix --no-warn-ignored --max-warnings=0 "${full[@]}" || status=1
  git add -- "${full[@]}" || exit 1
fi
for f in "${partial[@]}"; do
  git show ":$f" | "$eslint" --no-warn-ignored --max-warnings=0 --stdin --stdin-filename "$f" || {
    status=1
    echo "   ↑ $f has unstaged changes, so it was checked, not auto-fixed. Stage it fully to auto-fix."
  }
done
[ $status -eq 0 ] || echo "❌ pre-commit: ESLint problems remain (see above). Fix them and commit again."
exit $status
