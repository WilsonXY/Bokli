{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "bokli-cloud",
  "main": "index.ts",
  "compatibility_date": "2026-03-10",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [],
  "assets": {
    "directory": "../out",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "none"
  },
  "env": {
    "staging": {
      "name": "bokli-staging",
      "routes": [
        {
          "pattern": "bokli-staging.ktte.me",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "BOKLI_DB",
          "database_name": "bokli-staging",
          "database_id": "64a43e08-cb1e-4cf6-b783-09e40cddd294",
          "migrations_dir": "../drizzle"
        }
      ],
      "vars": {
        "ACCESS_ISSUER": "https://divine-morning-6055.cloudflareaccess.com",
        "ACCESS_AUD": "de8c699bbc6bf2296ce9bfd91ca76bf21efbf86bfcab1a11c5d0ee0cec74cdd6",
        "ACCESS_HEALTH_SERVICE_ID": "none.access",
        "APP_VERSION": "staging"
      }
    },
    "production": {
      "name": "bokli",
      "routes": [],
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      },
      "d1_databases": [
        {
          "binding": "BOKLI_DB",
          "database_name": "bokli",
          "database_id": "151e4f09-cd9a-4287-8ff7-719490fc5abf",
          "migrations_dir": "../drizzle"
        }
      ],
      "vars": {
        "ACCESS_ISSUER": "https://divine-morning-6055.cloudflareaccess.com",
        "ACCESS_AUD": "960ea6143bc6447155c0436e86221032beca8bb0467a5936f7b48fc7dacec201",
        "ACCESS_HEALTH_SERVICE_ID": "none.access",
        "APP_VERSION": "production"
      }
    }
  }
}
