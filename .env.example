# ==============================================================================
# Bokli Environment Configuration (.env.example)
# Copy this file to .env or .env.local and adjust values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network
# ------------------------------------------------------------------------------
# HTTP port for the Next.js server (default: 3000)
PORT=3000

# Node environment: 'production' on Ubuntu Server, 'development' for local work
NODE_ENV=production

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security (NextAuth / Auth.js)
# ------------------------------------------------------------------------------
# Secret key used to encrypt and sign session JWT tokens (minimum 32 random chars).
# Generate with: openssl rand -base64 32
# Either AUTH_SECRET or NEXTAUTH_SECRET can be set.
AUTH_SECRET=replace-with-a-secure-random-32-char-secret
NEXTAUTH_SECRET=replace-with-a-secure-random-32-char-secret

# Canonical public base URL for NextAuth callbacks, redirects, and cookie scoping.
# - Local development:  http://localhost:3000
# - Ubuntu Server LAN:  http://192.168.0.x:3000 (replace with server LAN IP)
# - Interim ngrok:      https://<subdomain>.ngrok-free.app
AUTH_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. Database Path Contract (Coupling point for Hermes backup reader)
# ------------------------------------------------------------------------------
# Absolute path to the SQLite database file.
# Default if unset: ./data/bokli.db relative to repo root.
# On production Ubuntu Server, provide the full absolute path so the DB location
# is persistent and unambiguous across restarts and service working directories.
BOKLI_DB_PATH=/home/penguin/projects/bokli/data/bokli.db

# ------------------------------------------------------------------------------
# 4. Initial Family User Seed Passwords
# ------------------------------------------------------------------------------
# Initial passwords used by `npm run db:seed` for the two family accounts:
# - 'mom'   (Operator role: daily bookkeeping entry and review)
# - 'katte' (Admin role: month close reopen, cost category management)
# Note: Subsequent password changes can be done anytime via CLI:
#   npm run reset-password -- <username>
BOKLI_MOM_PASSWORD=replace-with-mom-password
BOKLI_ADMIN_PASSWORD=replace-with-admin-password
