{
  "name": "bokli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "cloud:local": "node scripts/cloud-local.mjs",
    "test": "vitest run --max-workers=1",
    "test:unit": "vitest run --max-workers=1 --project unit",
    "test:deploy": "vitest run --max-workers=1 --project deploy",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:generate": "drizzle-kit generate",
    "test:d1": "vitest run --config workers/d1-tests/vitest.config.ts --max-workers=1 && vitest run --config workers/api-tests/vitest.config.ts --max-workers=1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "next": "^15.5.27",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.12.21",
    "@cloudflare/workers-types": "4.20260310.1",
    "@eslint/eslintrc": "^3.3.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "better-sqlite3": "^11.10.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.25.12",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.27",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
