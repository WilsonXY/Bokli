{
  "name": "bokli",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build && node -e \"const fs=require('fs'); fs.cpSync('.next-prod/static', '.next-prod/standalone/.next-prod/static', {recursive:true}); if(fs.existsSync('public')) fs.cpSync('public', '.next-prod/standalone/public', {recursive:true});\"",
    "start": "node .next-prod/standalone/server.js",
    "test": "vitest run --max-workers=1",
    "test:unit": "vitest run --max-workers=1 --project unit",
    "test:deploy": "vitest run --max-workers=1 --project deploy",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "reset-password": "tsx src/cli/reset-password.ts",
    "smoke:login": "node scripts/smoke-login.mjs",
    "smoke:ci": "bash scripts/ci-smoke-login.sh"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "better-sqlite3": "^11.10.0",
    "drizzle-orm": "^0.45.3",
    "next": "^16.3.8",
    "next-auth": "^5.0.0-beta.32",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
